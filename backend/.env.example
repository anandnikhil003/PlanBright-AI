# Backend Environment Variables
# Copy this file to .env and fill in your values

# Azure OpenAI (required for AI agents)
AZURE_API_KEY=your_rotated_azure_api_key_here
# Use the full deployment URL; omit the accidental trailing %27 if copied from elsewhere.
BRIDGE_AZURE_OPENAI_URL=https://agent365-integration.services.ai.azure.com/openai/deployments/gpt-4o/chat/completions?api-version=2024-12-01-preview
# Required for document and bot search; deploy an embeddings model in Azure first
AZURE_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name
# Required only if using LlamaParse document parsing
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# Authentication Provider URLs (token validation)
# Keep AUTH_MODE=external for the real auth provider. Local testing only: set it to development.
AUTH_MODE=external
DEV_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
# Used only when AUTH_MODE=external
VALID_URL=https://your-auth-provider.com/validate
AUTH_URL=https://your-auth-provider.com/activity
PROFILE_URL=https://your-auth-provider.com/profile

# Supabase (PostgreSQL) - Required for database operations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key_here

# Bot Data Directory (for file storage)
UC_BOT_DATA_DIRECTORY=./data

# Optional: Google API credentials (if using Google Docs export)
# GOOGLE_API_CREDENTIALS_PATH=./uc_googleapi_dev_credentials.json

# Server Configuration
HOST=0.0.0.0
PORT=8000
